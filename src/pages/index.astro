---
import CourseLayout from '../layouts/CourseLayout.astro';
import { courseSubtitle, courseTitle, lessons } from '../data/course.js';
---
<CourseLayout title={courseTitle} bannerImage="/images/banners/landing.png" bannerPosition="center 42%" bannerPositionTablet="center 42%" bannerPositionMobile="76% 42%">
  <Fragment slot="hero">
    <h1 class="mt-4 max-w-3xl text-4xl font-black leading-tight md:text-6xl">{courseTitle}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-white/75">{courseSubtitle}</p>
    <a href={`/lessons/${lessons[0].id}`} class="focus-ring mt-8 inline-flex rounded bg-tfgRed px-5 py-3 font-bold text-white hover:bg-foschini">Start Course</a>
  </Fragment>
  <section class="mx-auto max-w-5xl px-5 py-8 lg:px-10">
    <div>
      <h2 class="text-2xl font-black">Lessons</h2>
      <div class="mt-4 grid gap-4">
      {lessons.map((lesson) => (
        <a href={`/lessons/${lesson.id}`} class="course-block block p-5 transition hover:-translate-y-0.5 hover:border-tfgRed">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-tfgRed">Lesson {lesson.number}</p>
              <h3 class="mt-1 text-xl font-black">{lesson.title}</h3>
              {lesson.objective && <p class="mt-2 max-w-3xl text-sm leading-6 text-graphite">{lesson.objective}</p>}
            </div>
            <span class="rounded bg-ink px-4 py-2 text-sm font-bold text-white">Open</span>
          </div>
        </a>
      ))}
      </div>
    </div>
  </section>
  <script define:vars={{ ids: lessons.map((lesson) => lesson.id) }}>
    document.documentElement.dataset.lessonIds = JSON.stringify(ids);
  </script>
</CourseLayout>
