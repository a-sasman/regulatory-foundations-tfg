---
import { AlertTriangle, Check, CheckSquare, ChevronDown, ClipboardList, Download, Layers3, MessageSquareQuote, PenLine, Sparkles } from 'lucide-astro';
import { resources } from '../data/course.js';
import RichText from './RichText.astro';

const { block, index } = Astro.props;
const iconClass = 'text-tfgRed';
const titleClass = 'text-ink';
const bodyClass = 'text-graphite';
const reviewIconClass = iconClass;
const correctFeedbackValue = JSON.stringify(Array.isArray(block.correctFeedback ?? block.feedback) ? (block.correctFeedback ?? block.feedback) : (block.correctFeedback ?? block.feedback) ? [block.correctFeedback ?? block.feedback] : []);
const incorrectFeedbackValue = JSON.stringify(Array.isArray(block.incorrectFeedback) ? block.incorrectFeedback : block.incorrectFeedback ? [block.incorrectFeedback] : []);
const tipValue = JSON.stringify(Array.isArray(block.tip) ? block.tip : block.tip ? [block.tip] : []);
const isPillCards = block.layout === 'pills';
---
{block.type === 'statement' && (
  <section class="course-block overflow-hidden">
    <div class="border-l-4 border-tfgRed p-6 md:p-8">
      {block.eyebrow && <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-tfgRed">{block.eyebrow}</p>}
      {block.title && <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>}
      <RichText items={block.copy} className={`${block.title ? 'mt-4' : ''} space-y-3 text-base leading-7 ${bodyClass}`} />
    </div>
  </section>
)}

{block.type === 'quote' && (
  <section class="course-block callout-bubble p-7 text-ink md:p-9">
    <div class="flex items-center gap-3">
      <MessageSquareQuote class="text-ink" size={34} />
      {block.eyebrow && <p class="text-xs font-bold uppercase tracking-[0.22em] text-tfgRed">{block.eyebrow}</p>}
    </div>
    <RichText items={block.copy} className={`mt-5 space-y-2 text-2xl font-black leading-tight ${titleClass}`} />
    <RichText items={block.detail} className={`mt-4 max-w-3xl space-y-3 leading-7 ${bodyClass}`} />
  </section>
)}

{block.type === 'text' && (
  <section class="course-block p-6 md:p-8">
    {block.title && <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>}
    <RichText items={block.copy} className={`${block.title ? 'mt-4' : ''} space-y-3 leading-7 ${bodyClass}`} />
  </section>
)}

{block.type === 'scenario' && (
  <section class="course-block overflow-hidden">
    <div class="bg-foschini p-6 text-white md:p-8">
      <div class="flex items-center gap-3">
        <AlertTriangle size={32} />
        <h2 class="text-2xl font-black">{block.title}</h2>
      </div>
      <p class="mt-3 text-white/75">Scenario</p>
    </div>
    <RichText items={block.copy} className={`space-y-4 p-6 text-lg leading-8 md:p-8 ${bodyClass}`} />
  </section>
)}

{block.type === 'cards' && (
  <section class="course-block p-6 md:p-8">
    <div class="mb-5 flex items-center gap-3">
      <Layers3 class={reviewIconClass} size={26} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    {block.intro && <RichText items={block.intro} className={`mb-5 space-y-3 leading-7 ${bodyClass}`} />}
    <div class={isPillCards ? 'tone-grid pill-grid grid gap-4 sm:grid-cols-2 xl:grid-cols-4' : 'tone-grid grid gap-4 sm:grid-cols-2'}>
      {block.cards.map((card) => (
        <article class={isPillCards ? 'tone-chip pill-chip p-6 text-center' : 'tone-chip p-5'}>
          {!block.hideMarkers && <div class="mb-4 h-10 w-10 rounded card-marker" aria-hidden="true"></div>}
          <h3 class={`font-black ${isPillCards ? 'text-base leading-snug' : ''} ${titleClass}`}>{card.title ?? card[0]}</h3>
          <RichText items={card.copy ?? card[1]} className={`mt-2 space-y-2 ${isPillCards ? 'text-base leading-7' : 'text-sm leading-6'} ${bodyClass}`} />
        </article>
      ))}
    </div>
    {block.copy && <RichText items={block.copy} className={`mt-5 space-y-3 leading-7 ${bodyClass}`} />}
  </section>
)}

{block.type === 'tabs' && (
  <section class="course-block p-6 md:p-8" data-tabs>
    {block.title && (
      <div class="flex items-center gap-3">
        <Layers3 class={reviewIconClass} size={28} />
        <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
      </div>
    )}
    {block.intro && <RichText items={block.intro} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    <div class="mt-5 flex flex-wrap gap-2" role="tablist" aria-label={block.ariaLabel ?? block.title}>
      {block.tabs.map((tab, tabIndex) => (
        <button
          id={`tab-${index}-${tabIndex}`}
          class={`focus-ring rounded border border-black/10 px-4 py-3 text-left font-bold hover:border-tfgRed ${tabIndex === 0 ? 'bg-ink text-white' : 'text-graphite'}`}
          type="button"
          role="tab"
          aria-selected={tabIndex === 0 ? 'true' : 'false'}
          aria-controls={`tabpanel-${index}-${tabIndex}`}
          tabindex={tabIndex === 0 ? '0' : '-1'}
          data-tab
        >{tab.title}</button>
      ))}
    </div>
    {block.tabs.map((tab, tabIndex) => (
      <div
        id={`tabpanel-${index}-${tabIndex}`}
        class="mt-4 rounded border border-black/10 bg-white p-5"
        role="tabpanel"
        aria-labelledby={`tab-${index}-${tabIndex}`}
        hidden={tabIndex !== 0}
        data-tab-panel
      >
        <RichText items={tab.copy} className={`space-y-3 leading-7 ${bodyClass}`} />
      </div>
    ))}
  </section>
)}

{block.type === 'table' && (
  <section class="course-block p-6 md:p-8">
    <div class="flex items-center gap-3">
      <Layers3 class={reviewIconClass} size={28} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    <div class="mt-5 overflow-x-auto">
      <table class={`w-full min-w-[640px] border-collapse text-left ${bodyClass}`}>
        <thead>
          <tr>
            {block.headers.map((header) => <th class="border border-black/10 bg-mist p-4" scope="col">{header}</th>)}
          </tr>
        </thead>
        <tbody>
          {block.rows.map((row) => (
            <tr>
              {row.map((cell, cellIndex) => <td class={`border border-black/10 p-4 align-top ${cellIndex === 0 ? 'bg-ciSage/20 font-semibold' : 'bg-white'}`}>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {block.footer && <RichText items={block.footer} className={`mt-5 space-y-3 rounded bg-ciTeal/20 p-4 font-semibold leading-7 ${bodyClass}`} />}
  </section>
)}

{block.type === 'accordion' && (
  <section class="course-block p-6 md:p-8">
    {block.title && (
      <div class="flex items-center gap-3">
        <ChevronDown class={reviewIconClass} size={28} />
        <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
      </div>
    )}
    {block.intro && <RichText items={block.intro} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    <div class="mt-5 divide-y divide-black/10">
      {block.items.map((item) => (
        <details class="group py-4">
          <summary class={`flex cursor-pointer list-none items-center justify-between gap-4 font-bold ${titleClass}`}>
            <span>{item.title ?? item[0]}</span>
            <ChevronDown class="shrink-0 text-tfgRed transition group-open:rotate-180" size={20} />
          </summary>
          <RichText items={item.copy ?? item[1]} className={`mt-3 space-y-3 leading-7 ${bodyClass}`} />
        </details>
      ))}
    </div>
  </section>
)}

{block.type === 'process' && (
  <section class="course-block p-6 md:p-8">
    {(block.title || block.intro) && (
      <div class="mb-6 flex items-center gap-3">
        <Sparkles class={reviewIconClass} size={26} />
        <div>
          {block.title && <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>}
          {block.intro && <RichText items={block.intro} className={`mt-1 space-y-2 ${bodyClass}`} />}
        </div>
      </div>
    )}
    <ol class="process-list space-y-4">
      {block.steps.map((step, i) => (
        <li class={`grid gap-4 rounded border border-black/10 bg-white p-4 sm:grid-cols-[64px_1fr] ${block.centerSteps ? 'items-center' : ''}`}>
          <span class="process-step-badge grid min-h-12 w-16 place-items-center rounded px-2 text-center text-xs font-black text-white">Step {i + 1}</span>
          <span>
            <span class={`block font-black ${titleClass}`}>{step.title ?? step[0]}</span>
            <RichText items={step.copy ?? step[1]} className={`mt-1 space-y-2 leading-6 ${bodyClass}`} />
          </span>
        </li>
      ))}
    </ol>
  </section>
)}

{block.type === 'flow' && (
  <section class="course-block p-6 md:p-8">
    <div class="mb-6 flex items-center gap-3">
      <Sparkles class={reviewIconClass} size={26} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    <ol class="fairness-flow grid gap-4 md:grid-cols-5">
      {block.items.map((item, i) => (
        <li class="flow-step relative rounded border border-black/10 bg-white p-4">
          <span class="process-step-badge mb-4 grid h-10 w-10 place-items-center rounded font-black text-white">{i + 1}</span>
          <span class={`block text-sm font-black leading-snug ${titleClass}`}>{item}</span>
        </li>
      ))}
    </ol>
    {block.footer && <RichText items={block.footer} className={`mt-6 space-y-3 rounded bg-ciTeal/20 p-4 font-semibold leading-7 ${bodyClass}`} />}
  </section>
)}

{block.type === 'quiz' && (
  <section class="course-block p-6 md:p-8" data-activity="quiz" data-interaction data-multi={block.multi ? 'true' : 'false'} data-correct={JSON.stringify(block.correct)} data-correct-feedback={correctFeedbackValue} data-incorrect-feedback={incorrectFeedbackValue} data-tip={tipValue}>
    <div class="flex items-center gap-3">
      <CheckSquare class={reviewIconClass} size={28} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.heading ?? block.title}</h2>
    </div>
    {block.copy && <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    {block.question && <p class={`mt-4 text-lg font-semibold ${bodyClass}`}>{block.question}</p>}
    {block.instruction && <p class={`mt-2 text-sm font-semibold ${bodyClass}`}>{block.instruction}</p>}
    <div class="mt-5 grid gap-3">
      {block.options.map((option) => (
        <button class={`quiz-option focus-ring ${bodyClass}`} type="button" aria-pressed="false" data-option data-value={option}>
          <span class="quiz-option-marker" aria-hidden="true"><Check class="quiz-option-check" size={16} /></span>
          <span>{option}</span>
        </button>
      ))}
    </div>
    <button class="focus-ring mt-5 rounded bg-ink px-5 py-3 font-bold text-white hover:bg-tfgRed" data-check>Check answer</button>
    <div class="mt-5 hidden rounded border bg-white p-4" data-feedback>
      <p class="font-black" data-result></p>
      <div class={`mt-2 space-y-2 leading-7 ${bodyClass}`} data-feedback-copy></div>
      <div class={`mt-4 hidden space-y-2 rounded bg-sage p-4 text-sm font-semibold ${bodyClass}`} data-tip-copy></div>
    </div>
  </section>
)}

{block.type === 'reflection' && (
  <section
    class="course-block p-6 md:p-8"
    data-activity="reflection"
    data-scorm-interaction-id={block.scormInteraction?.id}
    data-scorm-interaction-description={block.scormInteraction ? block.question : undefined}
  >
    <PenLine class={reviewIconClass} size={28} />
    <h2 class={`mt-3 text-2xl font-black ${titleClass}`}>{block.title}</h2>
    {block.copy && <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    <p class={`mt-3 text-lg font-semibold ${bodyClass}`}>{block.question}</p>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {block.options.map((option, optionIndex) => <label class={`rounded border border-black/10 bg-white p-4 text-sm font-semibold ${bodyClass}`}><input class="mr-2 accent-tfgRed" type={block.scormInteraction ? 'radio' : 'checkbox'} name={block.scormInteraction?.id} value={block.scormInteraction?.values?.[optionIndex] ?? option} data-reflection-option /> {option}</label>)}
    </div>
    {block.feedback && <RichText items={block.feedback} className={`mt-5 space-y-2 rounded bg-sage p-4 text-sm font-semibold ${bodyClass}`} />}
  </section>
)}

{block.type === 'reflectionText' && (
  <section class="course-block p-6 md:p-8" data-activity="reflectionText">
    <PenLine class={reviewIconClass} size={28} />
    <h2 class={`mt-3 text-2xl font-black ${titleClass}`}>{block.title}</h2>
    <label class={`mt-4 block ${bodyClass}`} for={`reflection-${index}`}>{block.prompt}</label>
    <textarea id={`reflection-${index}`} rows="5" class={`focus-ring mt-3 w-full rounded border border-black/10 bg-white p-4 ${bodyClass}`} placeholder="Type your reflection here..." data-reflection-text></textarea>
    {block.note && <p class={`mt-3 text-sm ${bodyClass}`}>{block.note}</p>}
  </section>
)}

{block.type === 'matching' && (
  <section class="course-block p-6 md:p-8" data-activity="matching" data-matching data-match-correct-feedback={block.correctFeedback ?? ''} data-match-incorrect-feedback={block.incorrectFeedback ?? ''}>
    <div class="flex items-center gap-3">
      <Sparkles class={reviewIconClass} size={28} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    {block.copy && <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    {block.instruction && <p class={`mt-3 text-sm font-semibold ${bodyClass}`}>{block.instruction}</p>}
    <div class="mt-5 grid gap-4">
      {block.pairs.map((pair) => (
        <div class="grid gap-3 rounded border border-black/10 bg-ciTeal/20 p-4 md:grid-cols-[1fr_260px]" data-match-row data-answer={pair.answer ?? pair[1]}>
          <p class={`font-semibold leading-6 ${titleClass}`}>{pair.scenario ?? pair[0]}</p>
          <div>
            <select class={`focus-ring w-full rounded border border-black/10 bg-white px-4 py-3 text-sm font-bold ${bodyClass}`} aria-label={`Match for ${pair.scenario ?? pair[0]}`}>
              <option value="">Select an answer</option>
              {(block.answers ?? block.pairs.map((option) => option.answer ?? option[1])).map((option) => <option value={option}>{option}</option>)}
            </select>
            <p class="mt-2 hidden text-sm font-bold" data-match-status aria-live="polite"></p>
          </div>
        </div>
      ))}
    </div>
    <button class="focus-ring mt-5 rounded bg-ink px-5 py-3 font-bold text-white hover:bg-tfgRed" data-match-check>Check matches</button>
    <p class={`mt-4 hidden rounded border bg-white p-4 font-semibold ${bodyClass}`} data-match-feedback role="status" aria-live="polite"></p>
  </section>
)}

{block.type === 'checklist' && (
  <section class="course-block p-6 md:p-8" data-activity="checklist">
    <div class="mb-5 flex items-center gap-3">
      <CheckSquare class={reviewIconClass} size={28} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {block.items.map((item) => <label class={`rounded border border-black/10 bg-white p-4 font-semibold ${bodyClass}`}><input type="checkbox" class="mr-2 accent-tfgRed" data-checklist-option /> {item}</label>)}
    </div>
  </section>
)}

{block.type === 'scenarioReflection' && (
  <section class="course-block p-6 md:p-8">
    <PenLine class={reviewIconClass} size={28} />
    <h2 class={`mt-3 text-2xl font-black ${titleClass}`}>{block.title}</h2>
    <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />
    <div class="mt-5 grid gap-3">
      {block.scenarios.map((scenario) => (
        <div class={`rounded border border-black/10 bg-white p-4 font-semibold ${bodyClass}`}>{scenario}</div>
      ))}
    </div>
    <RichText items={block.feedback} className={`mt-5 space-y-2 rounded bg-sage p-4 text-sm font-semibold ${bodyClass}`} />
  </section>
)}

{block.type === 'resources' && (
  <section class="course-block p-6 md:p-8">
    <ClipboardList class={reviewIconClass} size={28} />
    <h2 class={`mt-3 text-2xl font-black ${titleClass}`}>{block.title}</h2>
    {block.copy && <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {resources.map((resource) => (
        resource.href
          ? <a class="focus-ring rounded border border-dashed border-black/20 bg-ciSage/20 p-4 font-bold text-graphite hover:border-tfgRed hover:text-tfgRed" href={resource.href} target="_blank" rel="noreferrer">{resource.label}</a>
          : <div class="rounded border border-dashed border-black/20 bg-ciSage/20 p-4 font-bold text-graphite">{resource.label}</div>
      ))}
    </div>
  </section>
)}

{block.type === 'download' && (
  <section class="course-block p-6 md:p-8">
    <div class="flex items-center gap-3">
      <Download class={reviewIconClass} size={28} />
      <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    </div>
    {block.copy && <p class={`mt-4 leading-7 ${bodyClass}`}>{block.copy}</p>}
    <a class="focus-ring mt-5 inline-flex rounded bg-tfgRed px-5 py-3 font-bold text-white hover:bg-foschini" href={block.href} target="_blank" rel="noreferrer">{block.label}</a>
  </section>
)}

{block.type === 'downloads' && (
  <section class="course-block p-6 md:p-8">
    <div class="grid gap-4 sm:grid-cols-2">
      {block.items.map((item) => (
        <article class="rounded border border-black/10 bg-ciSage/20 p-5">
          <h2 class={`text-lg font-black ${titleClass}`}>{item.title}</h2>
          <a class="focus-ring mt-4 inline-flex rounded bg-tfgRed px-5 py-3 font-bold text-white hover:bg-foschini" href={item.href} target="_blank" rel="noreferrer">Open policy</a>
        </article>
      ))}
    </div>
  </section>
)}

{block.type === 'video' && (
  <section class="course-block p-6 md:p-8">
    <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    {block.copy && <RichText items={block.copy} className={`mt-4 space-y-3 leading-7 ${bodyClass}`} />}
    {block.videoTitle && <h3 class={`mt-6 text-lg font-black ${titleClass}`}>{block.videoTitle}</h3>}
    {block.available ? (
      <video class="mt-5 aspect-video w-full rounded bg-ink object-contain" controls preload="metadata">
        <source src={block.src} type="video/mp4" />
      </video>
    ) : (
      <div class="mt-5 grid min-h-52 place-items-center rounded border-2 border-dashed border-black/20 bg-mist p-6 text-center font-bold text-graphite" role="status">Video to be added</div>
    )}
  </section>
)}

{block.type === 'mediaPlaceholder' && (
  <section class="course-block p-6 md:p-8">
    <h2 class={`text-2xl font-black ${titleClass}`}>{block.title}</h2>
    <div class="mt-5 grid min-h-52 place-items-center rounded border-2 border-dashed border-black/20 bg-mist p-6 text-center font-bold text-graphite" role="status">{block.message}</div>
  </section>
)}
