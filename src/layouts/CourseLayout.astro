---
import '../styles/global.css';
import { BookOpen, Circle, Home, Menu } from 'lucide-astro';
import { courseTitle, lessons } from '../data/course.js';

const { title = courseTitle, currentId = '', bannerImage = '/images/banners/landing.jpg', bannerPosition = 'center center' } = Astro.props;
const currentIndex = lessons.findIndex((lesson) => lesson.id === currentId);
---
<!doctype html>
<html lang="en" data-current-lesson={currentId} data-lesson-ids={JSON.stringify(lessons.map((lesson) => lesson.id))}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen lg:grid lg:grid-cols-[320px_1fr]">
      <aside class="border-b border-black/10 bg-white/95 lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto lg:border-b-0 lg:border-r">
        <div class="flex items-center justify-between px-5 py-4 lg:block lg:px-6 lg:py-7">
          <a href="/" class="flex items-center gap-3">
            <img class="h-12 w-12 shrink-0 object-contain" src="/images/brand/tfg-logo.svg" alt="TFG logo" />
            <span>
              <span class="block max-w-48 text-sm font-semibold leading-tight text-ink">{courseTitle}</span>
            </span>
          </a>
          <button class="focus-ring rounded p-2 lg:hidden" data-menu-toggle aria-label="Toggle lesson menu">
            <Menu size={22} />
          </button>
        </div>
        <div class="hidden px-5 pb-5 lg:block lg:px-6" data-menu>
          <div class="course-block p-4">
            <div class="mb-3 flex items-center justify-between text-sm">
              <span class="font-semibold text-graphite">Course Progress</span>
              <span class="font-bold text-tfgRed" data-progress-label>0%</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-mist">
              <div class="h-full w-0 rounded-full bg-tfgRed transition-all" data-progress-bar></div>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-2 text-xs text-graphite">
              <span><strong data-complete-count>0</strong> completed</span>
              <span>{lessons.length} lessons</span>
            </div>
          </div>
          <nav class="mt-5 space-y-2" aria-label="Lessons">
            <a href="/" class={`focus-ring flex items-center gap-3 rounded px-3 py-3 text-sm font-semibold ${currentId === '' ? 'bg-ink text-white' : 'text-graphite hover:bg-white'}`}>
              <Home size={18} /> Home
            </a>
            {lessons.map((lesson, index) => (
              <a href={`/lessons/${lesson.id}`} class={`focus-ring group flex items-start gap-3 rounded px-3 py-3 text-sm ${lesson.id === currentId ? 'bg-ink text-white' : 'text-graphite hover:bg-white'}`} data-lesson-link={lesson.id}>
                <span class="mt-0.5 text-tfgRed group-[.bg-ink]:text-white" data-nav-icon={lesson.id}><Circle size={18} /></span>
                <span>
                  <span class="block text-xs font-bold uppercase">Lesson {lesson.number}</span>
                  <span class="block font-semibold leading-snug">{lesson.title}</span>
                </span>
              </a>
            ))}
          </nav>
        </div>
      </aside>
      <main>
        <header class="relative overflow-hidden border-b border-black/10 bg-ink text-white">
          <img class="absolute inset-0 h-full w-full object-cover" src={bannerImage} alt="" loading="eager" style={`object-position: ${bannerPosition};`} />
          <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/78 to-ink/30"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-transparent"></div>
          <div class="relative mx-auto max-w-5xl px-5 py-14 lg:px-10 lg:py-20">
            <div class="flex flex-wrap items-center gap-3 text-sm text-white/80">
              <BookOpen size={18} />
              <span>Employee Relations</span>
              {currentIndex >= 0 && <span>Lesson {lessons[currentIndex].number} of 7</span>}
            </div>
            <slot name="hero" />
          </div>
        </header>
        <slot />
      </main>
    </div>
    <script>
      const key = 'er-abridge-progress';
      const completionMode = 'scorm-v1';
      const lessonIds = JSON.parse(document.documentElement.dataset.lessonIds || '[]');
      const currentLessonId = document.documentElement.dataset.currentLesson || '';
      const scorm = createScormRuntime();
      scorm.initialize();

      function createScormRuntime() {
        function findApi(name) {
          let win = window;
          for (let i = 0; i < 8 && win; i += 1) {
            try {
              if (win[name]) return win[name];
              if (win.parent === win) break;
              win = win.parent;
            } catch {
              break;
            }
          }
          try {
            win = window.opener;
            for (let i = 0; i < 8 && win; i += 1) {
              if (win[name]) return win[name];
              if (win.parent === win) break;
              win = win.parent;
            }
          } catch {}
          return null;
        }

        const api2004 = findApi('API_1484_11');
        const api12 = findApi('API');
        const version = api2004 ? '2004' : api12 ? '1.2' : null;
        const api = api2004 || api12;
        let initialized = false;

        function call(method, value = '') {
          if (!api || typeof api[method] !== 'function') return '';
          try { return api[method](value); } catch { return ''; }
        }

        function setValue(field, value) {
          if (!api) return false;
          try {
            const result = version === '2004' ? api.SetValue(field, value) : api.LMSSetValue(field, value);
            return result === true || result === 'true';
          } catch {
            return false;
          }
        }

        function getValue(field) {
          if (!api) return '';
          try {
            const result = version === '2004' ? api.GetValue(field) : api.LMSGetValue(field);
            return typeof result === 'string' ? result : '';
          } catch {
            return '';
          }
        }

        return {
          initialize() {
            if (!api || initialized) return false;
            const result = version === '2004' ? call('Initialize') : call('LMSInitialize');
            initialized = result === true || result === 'true';
            return initialized;
          },
          getSuspendData() {
            if (!initialized) return '';
            return getValue(version === '2004' ? 'cmi.suspend_data' : 'cmi.suspend_data');
          },
          setSuspendData(value) {
            if (!initialized) return false;
            return setValue('cmi.suspend_data', value);
          },
          setLocation(value) {
            if (!initialized || !value) return false;
            return setValue(version === '2004' ? 'cmi.location' : 'cmi.core.lesson_location', value);
          },
          setProgress(done, total) {
            if (!initialized || !total) return false;
            const ratio = done / total;
            if (version === '2004') {
              setValue('cmi.progress_measure', String(Math.min(1, ratio).toFixed(2)));
            } else {
              setValue('cmi.core.score.raw', String(Math.round(ratio * 100)));
            }
            return true;
          },
          setCompletion(complete) {
            if (!initialized) return false;
            if (version === '2004') {
              setValue('cmi.completion_status', complete ? 'completed' : 'incomplete');
              if (complete) setValue('cmi.success_status', 'passed');
            } else {
              setValue('cmi.core.lesson_status', complete ? 'completed' : 'incomplete');
            }
            return true;
          },
          commit() {
            if (!initialized) return false;
            const result = version === '2004' ? call('Commit') : call('LMSCommit');
            return result === true || result === 'true';
          },
          terminate() {
            if (!initialized) return false;
            const result = version === '2004' ? call('Terminate') : call('LMSFinish');
            initialized = false;
            return result === true || result === 'true';
          },
        };
      }

      function readProgress() {
        let progress;
        const stored = scorm.getSuspendData() || localStorage.getItem(key) || '{}';
        try { progress = JSON.parse(stored); } catch { progress = {}; }
        return migrateProgress(progress);
      }

      function migrateProgress(progress) {
        if (progress.__completionMode === completionMode) return progress;
        const migrated = { __completionMode: completionMode };
        lessonIds.forEach((id) => {
          const lesson = progress[id] || {};
          migrated[id] = {
            viewed: Boolean(lesson.viewed || lesson.complete),
            activities: lesson.activities || {},
            inputs: lesson.inputs || {},
            complete: Boolean(lesson.complete && lesson.activities),
            completedAt: lesson.completedAt,
          };
        });
        return migrated;
      }

      function ensureLesson(progress, id) {
        if (!progress[id]) progress[id] = { viewed: false, activities: {}, inputs: {}, complete: false };
        if (!progress[id].activities) progress[id].activities = {};
        if (!progress[id].inputs) progress[id].inputs = {};
        return progress[id];
      }

      function writeProgress(progress) {
        progress.__completionMode = completionMode;
        const serialized = JSON.stringify(progress);
        localStorage.setItem(key, serialized);
        scorm.setSuspendData(serialized);
        if (currentLessonId) scorm.setLocation(currentLessonId);
        syncScormCompletion(progress);
        scorm.commit();
        renderProgress();
      }

      function syncScormCompletion(progress) {
        const done = lessonIds.filter((id) => progress[id]?.complete).length;
        const complete = lessonIds.length > 0 && done === lessonIds.length;
        scorm.setProgress(done, lessonIds.length);
        scorm.setCompletion(complete);
      }

      function updateProgress(mutator) {
        const progress = readProgress();
        mutator(progress);
        writeProgress(progress);
      }

      function activityId(activity, index) {
        return activity.dataset.activityId || `${activity.getAttribute('data-activity')}-${index}`;
      }

      function requiredActivities() {
        return [...document.querySelectorAll('[data-activity]')];
      }

      function readActivityInput(activity) {
        if (activity.matches('[data-activity="reflection"]')) {
          return {
            checked: [...activity.querySelectorAll('[data-reflection-option]')]
              .map((input, index) => input.checked ? index : -1)
              .filter((index) => index >= 0),
          };
        }
        if (activity.matches('[data-activity="reflectionText"]')) {
          return { text: activity.querySelector('[data-reflection-text]')?.value || '' };
        }
        if (activity.matches('[data-activity="checklist"]')) {
          return {
            checked: [...activity.querySelectorAll('[data-checklist-option]')]
              .map((input, index) => input.checked ? index : -1)
              .filter((index) => index >= 0),
          };
        }
        if (activity.matches('[data-activity="matching"]')) {
          return { values: [...activity.querySelectorAll('select')].map((select) => select.value) };
        }
        return null;
      }

      function storeActivityInput(progress, activity, id) {
        const input = readActivityInput(activity);
        const lesson = ensureLesson(progress, currentLessonId);
        if (input) {
          lesson.inputs[id] = input;
        } else {
          delete lesson.inputs[id];
        }
      }

      function restoreActivityInput(activity, input) {
        if (!input) return;
        if (activity.matches('[data-activity="reflection"]')) {
          activity.querySelectorAll('[data-reflection-option]').forEach((checkbox, index) => {
            checkbox.checked = input.checked?.includes(index) || false;
          });
        }
        if (activity.matches('[data-activity="reflectionText"]')) {
          const textarea = activity.querySelector('[data-reflection-text]');
          if (textarea) textarea.value = input.text || '';
        }
        if (activity.matches('[data-activity="checklist"]')) {
          activity.querySelectorAll('[data-checklist-option]').forEach((checkbox, index) => {
            checkbox.checked = input.checked?.includes(index) || false;
          });
        }
        if (activity.matches('[data-activity="matching"]')) {
          activity.querySelectorAll('select').forEach((select, index) => {
            select.value = input.values?.[index] || '';
          });
        }
      }

      function freeformActivityComplete(activity) {
        if (activity.matches('[data-activity="reflection"]')) {
          return Boolean(activity.querySelector('[data-reflection-option]:checked'));
        }
        if (activity.matches('[data-activity="reflectionText"]')) {
          return Boolean(activity.querySelector('[data-reflection-text]')?.value.trim());
        }
        if (activity.matches('[data-activity="checklist"]')) {
          const checks = [...activity.querySelectorAll('[data-checklist-option]')];
          return checks.length > 0 && checks.every((check) => check.checked);
        }
        return null;
      }

      function setActivityComplete(activity, complete) {
        if (!currentLessonId) return;
        const activities = requiredActivities();
        const id = activityId(activity, activities.indexOf(activity));
        activity.dataset.activityComplete = complete ? 'true' : 'false';
        updateProgress((progress) => {
          const lesson = ensureLesson(progress, currentLessonId);
          if (complete) {
            lesson.activities[id] = true;
          } else {
            delete lesson.activities[id];
          }
          storeActivityInput(progress, activity, id);
          updateLessonCompletion(progress);
        });
      }

      function persistActivityInput(activity, forceIncomplete = false) {
        if (!currentLessonId) return;
        const activities = requiredActivities();
        const id = activityId(activity, activities.indexOf(activity));
        updateProgress((progress) => {
          const lesson = ensureLesson(progress, currentLessonId);
          storeActivityInput(progress, activity, id);
          if (forceIncomplete) {
            delete lesson.activities[id];
            activity.dataset.activityComplete = 'false';
          }
          updateLessonCompletion(progress);
        });
      }

      function updateLessonCompletion(progress = readProgress()) {
        if (!currentLessonId) return progress;
        const lesson = ensureLesson(progress, currentLessonId);
        const complete = lesson.viewed && requiredActivities().every((activity, index) => {
          const id = activityId(activity, index);
          return lesson.activities[id] || activity.dataset.activityComplete === 'true';
        });
        if (complete && !lesson.complete) lesson.completedAt = new Date().toISOString();
        lesson.complete = complete;
        if (!complete) delete lesson.completedAt;
        return progress;
      }

      function evaluateFreeformActivity(activity) {
        if (activity.matches('[data-activity="reflection"]')) {
          setActivityComplete(activity, Boolean(activity.querySelector('[data-reflection-option]:checked')));
        }
        if (activity.matches('[data-activity="reflectionText"]')) {
          setActivityComplete(activity, Boolean(activity.querySelector('[data-reflection-text]')?.value.trim()));
        }
        if (activity.matches('[data-activity="checklist"]')) {
          const checks = [...activity.querySelectorAll('[data-checklist-option]')];
          setActivityComplete(activity, checks.length > 0 && checks.every((check) => check.checked));
        }
      }

      function initializeCurrentLesson() {
        if (!currentLessonId) return;
        const progress = readProgress();
        const lesson = ensureLesson(progress, currentLessonId);
        lesson.viewed = true;
        requiredActivities().forEach((activity, index) => {
          const id = activityId(activity, index);
          activity.dataset.activityId = id;
          restoreActivityInput(activity, lesson.inputs[id]);
          const freeformComplete = freeformActivityComplete(activity);
          const complete = lesson.activities[id] || freeformComplete === true;
          if (freeformComplete === true) lesson.activities[id] = true;
          activity.dataset.activityComplete = complete ? 'true' : 'false';
        });
        updateLessonCompletion(progress);
        writeProgress(progress);
      }

      function renderProgress() {
        const progress = readProgress();
        const done = lessonIds.filter((id) => progress[id]?.complete).length;
        const pct = lessonIds.length ? Math.round((done / lessonIds.length) * 100) : 0;
        document.querySelectorAll('[data-progress-label]').forEach((el) => el.textContent = `${pct}%`);
        document.querySelectorAll('[data-progress-bar]').forEach((el) => el.style.width = `${pct}%`);
        document.querySelectorAll('[data-complete-count]').forEach((el) => el.textContent = done);
        document.querySelectorAll('[data-nav-icon]').forEach((el) => {
          const id = el.getAttribute('data-nav-icon');
          el.innerHTML = progress[id]?.complete ? '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.8 10.6a10 10 0 1 1-5.4-7.4"/><path d="m9 11 3 3L22 4"/></svg>' : '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>';
        });
      }

      document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => {
        document.querySelector('[data-menu]')?.classList.toggle('hidden');
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const option = target.closest('[data-option]');
        if (option) {
          const group = option.closest('[data-interaction]');
          const multi = group?.getAttribute('data-multi') === 'true';
          if (!multi) group?.querySelectorAll('[data-option]').forEach((el) => el.classList.remove('border-tfgRed', 'bg-red-50'));
          option.classList.toggle('border-tfgRed');
          option.classList.toggle('bg-red-50');
        }
        const check = target.closest('[data-check]');
        if (check) {
          const group = check.closest('[data-interaction]');
          const correct = JSON.parse(group?.getAttribute('data-correct') || '[]');
          const selected = [...group.querySelectorAll('[data-option].border-tfgRed')].map((el) => el.getAttribute('data-value'));
          const ok = correct.length === selected.length && correct.every((item) => selected.includes(item));
          group.querySelectorAll('[data-option]').forEach((el) => {
            const value = el.getAttribute('data-value');
            el.classList.remove('border-green-700', 'bg-green-50', 'border-tfgRed', 'bg-red-50');
            if (correct.includes(value)) {
              el.classList.add('border-green-700', 'bg-green-50');
            } else if (selected.includes(value)) {
              el.classList.add('border-tfgRed', 'bg-red-50');
            }
          });
          const feedback = group.querySelector('[data-feedback]');
          feedback.classList.remove('hidden');
          feedback.querySelector('[data-result]').textContent = ok ? 'Correct' : 'Good try';
          feedback.querySelector('[data-feedback-copy]').textContent = ok ? group.getAttribute('data-full-feedback') : 'Please try again.';
          feedback.classList.toggle('border-green-700', ok);
          feedback.classList.toggle('border-tfgRed', !ok);
          setActivityComplete(group, ok);
        }
        const matchCheck = target.closest('[data-match-check]');
        if (matchCheck) {
          const group = matchCheck.closest('[data-matching]');
          let allCorrect = true;
          group.querySelectorAll('[data-match-row]').forEach((row) => {
            const select = row.querySelector('select');
            const correct = row.getAttribute('data-answer');
            const ok = select.value === correct;
            row.classList.toggle('border-green-700', ok);
            row.classList.toggle('border-tfgRed', !ok);
            if (!ok) allCorrect = false;
          });
          const feedback = group.querySelector('[data-match-feedback]');
          feedback.classList.remove('hidden');
          feedback.textContent = allCorrect ? 'Correct. Each scenario has been matched to the right pathway.' : 'Good try, try again.';
          setActivityComplete(group, allCorrect);
        }
      });
      document.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const activity = target.closest('[data-activity="reflection"], [data-activity="reflectionText"], [data-activity="checklist"]');
        if (activity) evaluateFreeformActivity(activity);
      });
      document.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const activity = target.closest('[data-activity="reflection"], [data-activity="reflectionText"], [data-activity="checklist"]');
        if (activity) evaluateFreeformActivity(activity);
        const matching = target.closest('[data-activity="matching"]');
        if (matching && target.matches('select')) persistActivityInput(matching, true);
      });
      window.addEventListener('pagehide', () => {
        const progress = readProgress();
        if (currentLessonId) updateLessonCompletion(progress);
        const serialized = JSON.stringify(progress);
        localStorage.setItem(key, serialized);
        scorm.setSuspendData(serialized);
        if (currentLessonId) scorm.setLocation(currentLessonId);
        syncScormCompletion(progress);
        scorm.commit();
        scorm.terminate();
      });
      initializeCurrentLesson();
      renderProgress();
    </script>
  </body>
</html>
